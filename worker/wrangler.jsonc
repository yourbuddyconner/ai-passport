{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-passport",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "routes": [
    { "pattern": "aipassport.dev", "custom_domain": true },
    { "pattern": "www.aipassport.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/p/*", "/og/*"]
  },
  // Ciphertext retention for re-verification. Requires R2 to be enabled on the
  // account (Dashboard -> R2). Uncomment once enabled and run:
  //   npx wrangler r2 bucket create ai-passport-traces
  // "r2_buckets": [
  //   { "binding": "TRACES", "bucket_name": "ai-passport-traces" }
  // ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-passport",
      "database_id": "f3dbbafb-bf55-4e8c-995c-72576fc8fe8b"
    }
  ]
}
